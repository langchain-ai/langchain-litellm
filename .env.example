# Integration tests only (`make integration_tests`). Copy to .env and fill in;
# pytest-dotenv loads it. Unit tests (`make test`) need none of these.

# Chat, router and embeddings tests call OpenAI models through litellm.
OPENAI_API_KEY=

# OCR loader tests are skipped unless LITELLM_PROXY_URL is set.
LITELLM_PROXY_URL=
LITELLM_API_KEY=
# Left commented because an empty value would override the azure-document default.
# LITELLM_OCR_MODEL=azure-document
