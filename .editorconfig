# Matches what ruff and the pre-commit hooks enforce. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# ruff's default line length; pyproject.toml does not override it
max_line_length = 88

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# two trailing spaces are a Markdown hard line break
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
